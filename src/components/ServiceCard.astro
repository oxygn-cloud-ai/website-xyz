---
interface Props {
  title: string;
  description: string;
  id?: string;
  href?: string;
}

const { title, description, id, href } = Astro.props;
---
<article class="scard" {...(id ? { id } : {})}>
  <h3 class="scard-title">{title}</h3>
  <p class="scard-desc">{description}</p>
  {href && <a href={href} class="scard-link">Learn more &rarr;</a>}
</article>

<style>
  .scard {
    border: 1px solid #e8e4dc;
    border-radius: var(--radius);
    padding: 1.5rem;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .scard-title { font-weight: 600; font-size: var(--text-md); }
  .scard-desc { font-size: var(--text-sm); color: var(--ink-light); line-height: 1.55; }
  .scard-link { font-size: var(--text-sm); font-weight: 500; color: var(--ink); margin-top: 0.3rem; }
  .scard-link:hover { color: var(--accent); }
</style>
